#!/usr/bin/env bash
# otp - 6-digit TOTP codes (RFC 6238: SHA-1, 6 digits, 30s) from a saved 2FA secret.
#
#   otp -set "SECRET_OR_otpauth_URI"   save secret (replaces the previous one)
#   otp -set                           same, but prompts with hidden input
#   otp                                print current code (stdout)
#   otp -c                             also copy code to clipboard
#
# Secret is stored in ~/.config/otp/secret (mode 600, dir 700).
# Deps: bash, openssl, xxd, awk (present on macOS and most Linux).

set -u

dir="$HOME/.config/otp"
file="$dir/secret"

die() { printf 'otp: %s\n' "$*" >&2; exit 1; }

usage() {
  sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
}

# base32 (uppercase, no padding) -> hex bytes. Returns 1 if invalid.
b32hex() {
  printf '%s\n' "$1" | awk '
  BEGIN { A = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567" }
  {
    buf = 0; bits = 0
    for (i = 1; i <= length($0); i++) {
      v = index(A, substr($0, i, 1)) - 1
      if (v < 0) exit 1
      buf = buf * 32 + v; bits += 5
      if (bits >= 8) {
        bits -= 8
        printf "%02x", int(buf / 2^bits)
        buf = buf % (2^bits)
      }
    }
  }'
}

# Input (base32 or otpauth URI) -> normalized base32. Dies on bad input.
normalize() {
  local s=$1 alg digits period
  case "$s" in
    otpauth://*)
      local q=${s#*\?}
      alg=$(printf '%s' "$q"    | tr '&' '\n' | sed -n 's/^algorithm=//p' | tr 'a-z' 'A-Z')
      digits=$(printf '%s' "$q" | tr '&' '\n' | sed -n 's/^digits=//p')
      period=$(printf '%s' "$q" | tr '&' '\n' | sed -n 's/^period=//p')
      [ -z "$alg" ] || [ "$alg" = SHA1 ] || die "unsupported algorithm: $alg"
      [ -z "$digits" ] || [ "$digits" = 6 ] || die "unsupported digits: $digits"
      [ -z "$period" ] || [ "$period" = 30 ] || die "unsupported period: $period"
      s=$(printf '%s' "$q" | tr '&' '\n' | sed -n 's/^secret=//p')
      [ -n "$s" ] || die "otpauth URI has no secret="
      ;;
  esac
  s=$(printf '%s' "$s" | tr -d ' =\r\n\t-' | tr 'a-z' 'A-Z')
  [ -n "$s" ] || die "empty secret"
  b32hex "$s" >/dev/null || die "secret is not valid base32"
  printf '%s' "$s"
}

cmd_set() {
  local input=${1-} s tmp
  if [ -z "$input" ]; then
    [ -t 0 ] || die 'usage: otp -set "SECRET"'
    printf 'secret: ' >&2
    IFS= read -rs input || die "no input"
    printf '\n' >&2
  fi
  s=$(normalize "$input") || exit 1   # validates before touching the stored secret

  mkdir -p "$dir" && chmod 700 "$dir" || die "cannot create $dir"
  tmp=$(mktemp "$dir/secret.XXXXXX") || die "cannot write to $dir"
  if printf '%s\n' "$s" > "$tmp" && mv -f "$tmp" "$file"; then
    printf 'saved\n' >&2
  else
    rm -f "$tmp"; die "cannot save secret"
  fi
}

cmd_code() {
  local copy=$1 s key now remaining counter hmac offset word code out
  [ -r "$file" ] || die 'no secret saved; run: otp -set "SECRET"'
  s=$(cat "$file")
  key=$(b32hex "$s") || die "stored secret is invalid; run: otp -set \"SECRET\""

  now=$(date +%s)
  remaining=$(( 30 - now % 30 ))
  # Don't hand out a code that expires mid-typing: wait for the next window.
  if [ "$remaining" -lt 5 ]; then
    sleep "$remaining"
    now=$(date +%s)
    remaining=$(( 30 - now % 30 ))
  fi

  counter=$(printf '%016x' $(( now / 30 )))
  hmac=$(printf '%s' "$counter" | xxd -r -p \
         | openssl dgst -sha1 -mac HMAC -macopt "hexkey:$key" 2>/dev/null \
         | awk '{print $NF}')
  [ "${#hmac}" -eq 40 ] || die "hmac failed (openssl)"

  # RFC 4226 dynamic truncation.
  offset=$(( 16#${hmac:39:1} * 2 ))
  word=${hmac:offset:8}
  code=$(( (16#$word & 0x7fffffff) % 1000000 ))
  printf -v out '%06d' "$code"

  printf '%s\n' "$out"
  printf 'valid for %ss\n' "$remaining" >&2

  if [ "$copy" -eq 1 ]; then
    if command -v pbcopy >/dev/null 2>&1; then printf '%s' "$out" | pbcopy
    elif command -v xclip >/dev/null 2>&1; then printf '%s' "$out" | xclip -selection clipboard
    else die "no clipboard tool (pbcopy/xclip)"; fi
    printf 'copied\n' >&2
  fi
}

case "${1:-}" in
  -set|--set) cmd_set "${2-}" ;;
  -c)         cmd_code 1 ;;
  "")         cmd_code 0 ;;
  -h|--help)  usage ;;
  *)          die "unknown option: $1 (try -h)" ;;
esac
